# Copy to /etc/naturalcc-agent/naturalcc.env and set the model credential there.
CODE_AGENT_MODEL=deepseek-chat
CODE_AGENT_API_BASE=https://api.deepseek.com/v1
LIBCLANG_PATH=/opt/naturalcc-runtime/libclang-18.1.1/clang/native/libclang.so

# DEEPSEEK_API_KEY=<set-the-model-api-key-on-the-target-host>
