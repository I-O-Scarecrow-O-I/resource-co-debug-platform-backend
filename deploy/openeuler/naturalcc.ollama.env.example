# 可选的 /etc/naturalcc-agent/naturalcc.env 替代模板；不会自动覆盖默认 DeepSeek 配置。
# 使用前须确保本机 Ollama 服务和 qwen3:4b-instruct 模型已可用。
# Ollama 不需要 API Key；此模板不包含任何真实凭据。
# 部署时 NaturalCC 与后端使用本机共用工作区；此文件只加载到 NaturalCC 服务，不交给后端环境。
# CODE_AGENT_PROVIDER=ollama 是本地模型路由开关；Agent 的 Aider 工具沿用同一模型与地址配置。
CODE_AGENT_PROVIDER=ollama
CODE_AGENT_MODEL=qwen3:4b-instruct
CODE_AGENT_API_BASE=http://127.0.0.1:11434/v1

# 仅设置 NaturalCC 请求预算；Ollama 服务端的 num_ctx 仍须与模型实际配置匹配。
CODE_AGENT_CONTEXT_WINDOW_TOKENS=8192
CODE_AGENT_OUTPUT_RESERVE_TOKENS=2048

LIBCLANG_PATH=/opt/naturalcc-runtime/libclang-18.1.1/clang/native/libclang.so
