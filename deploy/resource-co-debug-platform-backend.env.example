# Copy to /etc/resource-co-debug-platform-backend/backend.env and set deployment values.
# This file must not contain model credentials or other secrets.

APP_NAME=resource-co-debug-platform-backend
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000

# Persistent project workspaces and SQLite task/log database.
STORAGE_ROOT=/var/lib/resource-co-debug-platform-backend/workspaces
TASK_DATABASE_PATH=/var/lib/resource-co-debug-platform-backend/tasks.sqlite3
DEFAULT_TASK_TIMEOUT_SECONDS=300
MAX_LOG_LINES_PER_TASK=2000

# Replace with the actual browser origins permitted to call this backend.
ALLOWED_CORS_ORIGINS=https://frontend.example.invalid

# NaturalCC runs as a separate Python 3.12 service.
# Model credentials belong only in that NaturalCC service environment, never here.
NATURALCC_BASE_URL=http://127.0.0.1:7860
NATURALCC_CONNECT_TIMEOUT_SECONDS=5
NATURALCC_REQUEST_TIMEOUT_SECONDS=30
# Keep false unless NaturalCC runs in an isolated container or restricted OS account.
NATURALCC_APPROVE_EXECUTE=false
