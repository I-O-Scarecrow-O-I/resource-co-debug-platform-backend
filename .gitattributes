# Auto detect text files and perform LF normalization
* text=auto

*.py   text eol=lf
*.sh   text eol=lf
*.c    text eol=lf
*.cc   text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  -text
*.jpg  -text
*.jpeg -text
*.gif  -text
*.pdf  -text

.gitattributes text eol=lf
*.service text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
.env text eol=lf
.env.* text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf