APP_NAME=resource-co-debug-platform-backend
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
STORAGE_ROOT=data/workspaces
DEFAULT_TASK_TIMEOUT_SECONDS=300
MAX_LOG_LINES_PER_TASK=2000
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# NaturalCC runs in its own Python 3.12 process. No model credential belongs here.
NATURALCC_BASE_URL=http://127.0.0.1:7860
NATURALCC_CONNECT_TIMEOUT_SECONDS=5
NATURALCC_REQUEST_TIMEOUT_SECONDS=30
# Keep false unless the NaturalCC process is isolated in a container or restricted OS account.
NATURALCC_APPROVE_EXECUTE=false

